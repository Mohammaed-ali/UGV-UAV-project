<?xml version="1.0"?>
<sdf version="1.9">
  <model name="uav08">
    <static>true</static>
    <link name="base">
      <inertial><mass>1.0</mass></inertial>
      <collision name="c"><geometry><box><size>0.5 0.5 0.12</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 0.5 0.12</size></box></geometry></visual>
    </link>
    <link name="mast">
      <pose>0 0 0.2 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.03</radius><length>0.4</length></cylinder></geometry></visual>
    </link>
    <link name="camera_link">
      <pose>0 0 0.35 0 0 0</pose>
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>/drones/uav08/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.3614</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
