            </image>
            <clip>
              <near>0.1</near>
              <far>100.0</far>
            </clip>
            <camera_info_topic>/dataset/rgb/camera_info</camera_info_topic>
          </camera>
          <always_on>true</always_on>
          <update_rate>10.0</update_rate>
        </sensor>
