        <sensor name="contact_uav08" type="contact">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/fieldlab/trays/uav08/contact</topic>
          <contact>
            <collision>pad_collision</collision>
            <topic>/fieldlab/trays/uav08/contact</topic>
          </contact>
        </sensor>
      </link>
      <joint name="tray_uav08_joint" type="prismatic">
        <parent>base_link</parent>
        <child>tray_uav08</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit>
            <lower>0</lower>
            <upper>1.65</upper>
            <effort>500</effort>
            <velocity>0.3</velocity>
          </limit>
          <dynamics>
            <damping>25</damping>
          </dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>tray_uav08_joint</joint_name>
        <topic>/fieldlab/trays/uav08/position</topic>
        <p_gain>250</p_gain>
        <i_gain>0</i_gain>
        <d_gain>35</d_gain>
        <cmd_max>200</cmd_max>
        <cmd_min>-200</cmd_min>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>tray_uav08</parent_link>
        <child_model>uav08</child_model>
        <child_link>base_link</child_link>
        <attach_topic>/fieldlab/trays/uav08/attach</attach_topic>
        <detach_topic>/fieldlab/trays/uav08/detach</detach_topic>
        <output_topic>/fieldlab/trays/uav08/latch</output_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/fieldlab/carrier/joints</topic>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
        <topic>/fieldlab/carrier/poses</topic>
      </plugin>
    </model>
  </world>
</sdf>