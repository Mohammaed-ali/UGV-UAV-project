<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="ugv">
    <pose>0 0 0.25 0 0 0</pose>
    <link name="base">
      <inertial>
        <mass>25</mass>
      </inertial>
      <collision name="c">
        <geometry>
          <box>
            <size>1.2 0.8 0.4</size>
          </box>
        </geometry>
      </collision>
      <visual name="v">
        <geometry>
          <box>
            <size>1.2 0.8 0.4</size>
          </box>
        </geometry>
      </visual>
    </link>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.86</wheel_separation>
      <wheel_radius>0.18</wheel_radius>
      <topic>/ugv/cmd_vel</topic>
      <odom_topic>/ugv/odom</odom_topic>
    </plugin>
    <link name="left_wheel">
      <pose>0 0.43 -0.15 1.57079632679 0 0</pose>
      <visual name="v">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="wheel_contact">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>1.0</mass>
      </inertial>
    </link>
    <link name="right_wheel">
      <pose>0 -0.43 -0.15 1.57079632679 0 0</pose>
      <visual name="v">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="wheel_contact">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>1.0</mass>
      </inertial>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>
    <link name="front_support">
      <pose>0.45 0 -0.25 0 0 0</pose>
      <collision name="contact">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="front_support_joint" type="fixed">
      <parent>base</parent>
      <child>front_support</child>
    </joint>
    <link name="rear_support">
      <pose>-0.45 0 -0.25 0 0 0</pose>
      <collision name="contact">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="rear_support_joint" type="fixed">
      <parent>base</parent>
      <child>rear_support</child>
    </joint>
  </model>
</sdf>