<sdf version="1.9"><world name="dataset_spike"><plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/><plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/><plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/><plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin><scene><ambient>0.5 0.5 0.5 1</ambient></scene><light name="sun" type="directional"><cast_shadows>true</cast_shadows><direction>-0.3 0.2 -1</direction><diffuse>0.8 0.8 0.8 1</diffuse></light><physics name="p" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>1</real_time_factor></physics><model name="ground"><static>true</static><link name="link"><visual name="ground"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry></visual></link></model><model name="target_10"><static>true</static><pose>-9.0 0 0.9 0 0 0</pose><link name="link"><visual name="shape"><geometry><box><size>0.5 0.5 1.8</size></box></geometry><material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material></visual></link><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>10</label></plugin></model><model name="target_20"><static>true</static><pose>-3.0 0 0.75 0 0 0</pose><link name="link"><visual name="shape"><geometry><box><size>4.5 1.8 1.5</size></box></geometry><material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material></visual></link><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>20</label></plugin></model><model name="target_30"><static>true</static><pose>3.0 0 1.4 0 0 0</pose><link name="link"><visual name="shape"><geometry><box><size>6 2.4 2.8</size></box></geometry><material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material></visual></link><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><l